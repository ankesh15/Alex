# ==========================================
# Alex — Environment Configuration Template
# ==========================================
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env

# --- Google Gemini LLM Configuration ---
# Obtain key from https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- PostgreSQL Database (pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=alex_db
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/alex_db

# --- Redis & Celery Message Broker ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- RAG Vector Search Configuration ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=5
# Cosine distance threshold (0.0 is identical; <= threshold is considered relevant)
RAG_SIMILARITY_THRESHOLD=0.48
