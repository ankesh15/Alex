# ==========================================
# Alex — Environment Configuration Template
# ==========================================
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env

# --- Google Gemini LLM Configuration ---
# Obtain API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- PostgreSQL Database with pgvector ---
# For local development via Docker Compose:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/alex_db
# For Railway production (Railway sets DATABASE_URL automatically if Postgres plugin is attached):
# DATABASE_URL=postgresql://postgres:password@host:port/railway

# --- File Storage & Upload Configuration ---
# Local: storage/documents
# Railway persistent Volume: /app/storage/documents
STORAGE_DIR=storage/documents
MAX_UPLOAD_SIZE_MB=20

# --- CORS & Frontend Configuration ---
# Comma-separated list of allowed web origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Deployed Vercel frontend URL (optional shortcut that gets appended to allowed origins)
FRONTEND_URL=https://your-alex-app.vercel.app

# --- Redis & Celery (Optional for Basic Deployment) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- RAG Vector Search & Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=5
# Cosine distance threshold (0.0 is identical; <= threshold is considered relevant)
RAG_SIMILARITY_THRESHOLD=0.48

# --- Conversation Memory ---
# Recent successful exchanges per conversation and scope included in prompts.
MEMORY_MAX_TURNS=8
# Deterministic character budget, not an exact token limit.
MEMORY_MAX_CHARS=12000

# --- Authentication ---
APP_ENV=development
# Local HTTP only. Production must use true, HTTPS, and APP_ENV=production.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=604800
SESSION_IDLE_SECONDS=43200
AUTH_RATE_MAX_ATTEMPTS=20
AUTH_RATE_WINDOW_SECONDS=300
# For cross-site Vercel/Railway domains: Secure=true, SameSite=none.
# Prefer a same-site/custom-domain setup; browsers may block third-party cookies.
# No JWT/signing key: opaque random session tokens are hashed in PostgreSQL.

# --- Persistent Chat History ---
# No new secrets or environment variables. Apply migrations 001–003 with:
# python -m app.core.migrate
# STORAGE_DIR must remain persistent: New Chat retains earlier documents.
# Explicit conversation deletion removes attached files; failed cleanup is retryable.
