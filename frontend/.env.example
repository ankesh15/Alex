# ===============================================
# Alex Frontend — Environment Configuration
# ===============================================
#
# Local Development:
# VITE_API_URL=http://localhost:8000
#
# Production (Vercel):
# Set VITE_API_URL in the Vercel Project Settings > Environment Variables
# pointing to your deployed Railway backend URL:
# VITE_API_URL=https://<your-railway-app-name>.up.railway.app

VITE_API_URL=http://localhost:8000

# Authentication uses HttpOnly cookies and in-memory CSRF tokens, never localStorage.
# Use one hostname consistently (localhost or 127.0.0.1).
# Configure backend CORS and cookie SameSite/Secure values for this frontend origin.

# History persists in PostgreSQL. Browser storage contains only the last selected
# conversation ID per user; all reopening requests recheck server ownership.
