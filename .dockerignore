# Git & VCS
.git
.gitignore

# Environment variables & secrets
.env
*.env
!.env.example

# Python virtual environments & caches
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Frontend assets (deployed separately to Vercel)
frontend/

# Local databases and volumes
postgres_data/
redis_data/

# Local uploaded documents
storage/documents/*
!storage/documents/.gitkeep

# IDEs & OS files
.idea/
.vscode/
.DS_Store
*.swp
*.log
